+package com.github.libretube.db.dao
+
+import androidx.room.Dao
+import androidx.room.Delete
+import androidx.room.Insert
+import androidx.room.OnConflictStrategy
+import androidx.room.Query
+import com.github.libretube.db.obj.DismissedChannel
+import kotlinx.coroutines.flow.Flow
+
+@Dao
+interface DismissedChannelDao {
+    @Query("SELECT * FROM dismissedChannel ORDER BY shownName")
+    suspend fun getAll(): List<DismissedChannel>
+
+    @Query("SELECT * FROM dismissedChannel ORDER BY shownName")
+    fun getAllFlow(): Flow<List<DismissedChannel>>
+
+    @Insert(onConflict = OnConflictStrategy.REPLACE)
+    suspend fun insert(dismissedChannel: DismissedChannel)
+
+    @Insert(onConflict = OnConflictStrategy.REPLACE)
+    suspend fun insertAll(dismissedChannels: List<DismissedChannel>)
+
+    @Delete
+    suspend fun deleteDismissedChannel(customInstance: DismissedChannel)
+
+    @Query("DELETE FROM dismissedChannel")
+    suspend fun deleteAll()
+}
