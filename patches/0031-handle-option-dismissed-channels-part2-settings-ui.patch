+package com.github.libretube.ui.adapters
+
+import android.util.Log
+import android.view.LayoutInflater
+import android.view.ViewGroup
+import androidx.lifecycle.LifecycleOwner
+import androidx.lifecycle.lifecycleScope
+import androidx.recyclerview.widget.ListAdapter
+import com.github.libretube.api.MediaServiceRepository
+import com.github.libretube.databinding.DismissedChannelRowBinding
+import com.github.libretube.db.obj.DismissedChannel
+import com.github.libretube.extensions.TAG
+import com.github.libretube.helpers.ImageHelper
+import com.github.libretube.ui.adapters.callbacks.DiffUtilItemCallback
+import com.github.libretube.ui.models.DismissedChannelsModel
+import com.github.libretube.ui.viewholders.DismissedChannelsViewHolder
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+class DismissedChannelsAdapter(
+    private val lifecycleOwner: LifecycleOwner,
+    private val viewModel: DismissedChannelsModel,
+    private val onClickInstance: (DismissedChannel) -> Unit,
+    private val onDeleteInstance: (DismissedChannel) -> Unit,
+) : ListAdapter<DismissedChannel, DismissedChannelsViewHolder>(
+    DiffUtilItemCallback()
+) {
+    override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): DismissedChannelsViewHolder {
+        val layoutInflater = LayoutInflater.from(parent.context)
+        val binding = DismissedChannelRowBinding.inflate(layoutInflater, parent, false)
+        return DismissedChannelsViewHolder(binding)
+    }
+
+    override fun onBindViewHolder(holder: DismissedChannelsViewHolder, position: Int) {
+        val dismissedChannel = getItem(position)!!
+
+        with (holder.binding) {
+            dismissedChannelName.text = dismissedChannel.shownName
+
+            lifecycleOwner.lifecycleScope.launch {
+                val response = try {
+                    withContext(Dispatchers.IO) {
+                        MediaServiceRepository.instance.getChannel(dismissedChannel.id)
+                    }
+                } catch (e: Exception) {
+                    Log.e(TAG(), e.stackTraceToString())
+                    return@launch
+                }
+                try {
+                    ImageHelper.loadImage(response.avatarUrl, channelImage, true)
+                }
+                catch (_: Exception) { }
+
+                if(response.name != dismissedChannel.shownName) {
+                    dismissedChannel.shownName = response.name ?: ""
+                    viewModel.add(dismissedChannel.id, response.name ?: "")
+                }
+            }
+
+            root.setOnClickListener {
+                onClickInstance(dismissedChannel)
+            }
+
+            deleteDismissedChannel.setOnClickListener {
+                onDeleteInstance.invoke(dismissedChannel)
+            }
+        }
+    }
+}
