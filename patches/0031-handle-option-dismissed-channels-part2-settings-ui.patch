+import com.github.libretube.databinding.DialogDismissedChannelsListBinding
+import com.github.libretube.ui.adapters.DismissedChannelsAdapter
+import com.github.libretube.ui.models.DismissedChannelsModel
+import com.google.android.material.dialog.MaterialAlertDialogBuilder
+import kotlinx.coroutines.flow.collectLatest
+import kotlinx.coroutines.launch
+import kotlin.getValue
+
+class DismissedChannelsListDialog: DialogFragment() {
+    val viewModel: DismissedChannelsModel by activityViewModels()
+
+    override fun onCreateDialog(savedInstanceState: Bundle?): Dialog {
+        val binding = DialogDismissedChannelsListBinding.inflate(layoutInflater)
+        val adapter = DismissedChannelsAdapter(
+            this,
+            viewModel,
+            onClickInstance = { },
+            onDeleteInstance = {
+                viewModel.delete(it)
+            }
+        )
+        binding.dismissedChannelsRecycler.adapter = adapter
+
+        lifecycleScope.launch {
+            viewModel.dismissedChannels.collectLatest {
+                adapter.submitList(it)
+            }
+        }
+
+        return MaterialAlertDialogBuilder(requireContext())
+            .setTitle(getString(R.string.dismissed_channels_list))
+            .setView(binding.root)
+            .setPositiveButton(getString(R.string.okay), null)
+            .setNegativeButton(getString(R.string.add_dismissed_channel), null)
+            .show()
+            .apply {
+                getButton(DialogInterface.BUTTON_NEGATIVE).setOnClickListener {
+                    CreateDismissedChannelDialog().show(childFragmentManager, null)
+                }
+            }
+    }
+}
