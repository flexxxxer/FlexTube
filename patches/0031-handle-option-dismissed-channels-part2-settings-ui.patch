+import com.github.libretube.extensions.parcelable
+import com.github.libretube.extensions.toastFromMainDispatcher
+import com.github.libretube.extensions.toastFromMainThread
+import com.github.libretube.ui.models.DismissedChannelsModel
+import com.google.android.material.dialog.MaterialAlertDialogBuilder
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import okhttp3.HttpUrl.Companion.toHttpUrlOrNull
+import java.net.MalformedURLException
+import kotlin.getValue
+
+class CreateDismissedChannelDialog : DialogFragment() {
+    val viewModel: DismissedChannelsModel by activityViewModels()
+
+    override fun onCreateDialog(savedInstanceState: Bundle?): Dialog {
+        val binding = DialogDismissedChannelBinding.inflate(layoutInflater)
+        arguments?.parcelable<DismissedChannel>(IntentData.dismissedChannel)?.let { initialInstance ->
+            binding.dismissedChannelId.setText(initialInstance.id)
+        }
+
+        binding.dismissedChannelId.setOnFocusChangeListener { _, hasFocus ->
+            if (hasFocus || !binding.dismissedChannelId.text.isNullOrEmpty()) return@setOnFocusChangeListener
+        }
+
+        return MaterialAlertDialogBuilder(requireContext())
+            .setTitle(R.string.dismissed_channel)
+            .setView(binding.root)
+            .setPositiveButton(R.string.add_dismissed_channel, null)
+            .setNegativeButton(R.string.cancel, null)
+            .show()
+            .apply {
+                getButton(DialogInterface.BUTTON_POSITIVE).setOnClickListener {
+                    val channelId = binding.dismissedChannelId.text.toString()
+                    lifecycleScope.launch {
+                        val response = try {
+                            withContext(Dispatchers.IO) {
+                                MediaServiceRepository.instance.getChannel(channelId)
+                            }
+                        } catch (e: Exception) {
+                            Log.e(TAG(), e.stackTraceToString())
+                            context.toastFromMainThread(R.string.invalid_channel_id)
+                            requireDialog().dismiss()
+                            return@launch
+                        }
+                        val channelName = response.name ?: ""
+                        try {
+                            viewModel.add(channelId, channelName)
+                            requireDialog().dismiss()
+                        } catch (e: Exception) {
+                            Log.e(TAG(), e.stackTraceToString())
+                            context.toastFromMainThread(R.string.invalid_channel_id)
+                        }
+                    }
+                }
+            }
+    }
+}
