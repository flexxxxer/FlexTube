+            app:key="flextube_show_shorts_toggle" />
+
+        <Preference
+            android:icon="@drawable/ic_awesome"
+            app:summary="@string/dismissed_channels_list_summary"
+            app:title="@string/dismissed_channels_list"
+            app:key="flextube_dismissed_channels_list" />
+
+    </PreferenceCategory>
+
+    <PreferenceCategory app:title="@string/player">
+
+        <SwitchPreferenceCompat
+            android:defaultValue="false"
+            android:icon="@drawable/ic_settings"
+            android:summary="@string/icon_only_video_bottom_actions_summary"
+            android:title="@string/icon_only_video_bottom_actions"
+            app:key="flextube_icon_only_video_bottom_actions_toggle" />
+
+        <SwitchPreferenceCompat
+            android:defaultValue="true"
+            android:icon="@drawable/ic_settings"
+            android:summary="@string/show_counters_summary"
+            android:title="@string/show_counters"
+            app:key="flextube_show_counters_toggle" />
+
+        <SwitchPreferenceCompat
+            android:defaultValue="true"
+            android:icon="@drawable/ic_settings"
+            android:dependency="flextube_show_counters_toggle"
+            android:title="@string/show_like_dislike_buttons"
+            app:key="flextube_show_like_dislike_toggle" />
+
+        <SwitchPreferenceCompat
+            android:defaultValue="true"
+            android:icon="@drawable/ic_settings"
+            android:title="@string/show_comment_section"
+            app:key="flextube_show_comment_section_toggle" />
+
+        <SwitchPreferenceCompat
+            android:defaultValue="false"
+            android:icon="@drawable/ic_settings"
+            android:dependency="flextube_show_comment_section_toggle"
+            android:summary="@string/automatically_expand_comments_summary"
+            android:title="@string/automatically_expand_comments"
+            app:key="flextube_automatically_expand_comments_toggle" />
+
+        <SwitchPreferenceCompat
+            android:defaultValue="false"
+            android:icon="@drawable/ic_settings"
+            android:summary="@string/automatically_expand_description_summary"
+            android:title="@string/automatically_expand_description"
+            app:key="flextube_automatically_expand_description_toggle" />
+
+    </PreferenceCategory>
+
+</PreferenceScreen>
